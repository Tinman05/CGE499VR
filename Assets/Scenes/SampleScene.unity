  m_Script: {fileID: 11500000, guid: aa55056875135954ab4b53957d11a724, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  bubble: {fileID: 1262711648}
  label: {fileID: 1977751580}
  lines:
  - "\u0E22\u0E34\u0E19\u0E14\u0E35\u200B\u0E15\u0E49\u0E2D\u0E19\u0E23\u0E31\u0E1A\u200B\u0E2A\u0E39\u0E48\u200B\u0E2A\u0E27\u0E19\u200B\u0E44\u0E14\u0E42\u0E19\u0E40\u0E2A\u0E32\u0E23\u0E4C\u200B!
    \u0E09\u0E31\u0E19\u200B\u0E40\u0E1B\u0E47\u0E19\u200B\u0E44\u0E01\u0E14\u0E4C\u200B\u0E02\u0E2D\u0E07\u200B\u0E04\u0E38\u0E13"
  - "\u0E2B\u0E22\u0E34\u0E1A\u200B\u0E40\u0E19\u0E37\u0E49\u0E2D\u200B\u0E08\u0E32\u0E01\u200B\u0E08\u0E32\u0E19\u200B\u0E42\u0E14\u0E22\u200B\u0E01\u0E14\u200B\u0E1B\u0E38\u0E48\u0E21\u200B\u0E44\u0E01
    (\u0E1B\u0E38\u0E48\u0E21\u200B\u0E14\u0E49\u0E32\u0E19\u0E1A\u0E19) \u0E17\u0E35\u0E48\u200B\u0E08\u0E2D\u0E22\u200B\u0E04\u0E49\u0E32\u0E07\u200B\u0E44\u0E27\u0E49"
  - "\u0E42\u0E22\u0E19\u200B\u0E40\u0E19\u0E37\u0E49\u0E2D\u200B\u0E25\u0E07\u200B\u0E44\u0E1B\u200B\u0E43\u0E19\u200B\u0E2B\u0E25\u0E38\u0E21\u200B\u0E41\u0E25\u0E49\u0E27\u200B\u0E23\u0E2D\u0E14\u0E39\u200B\u0E44\u0E14\u0E42\u0E19\u0E40\u0E2A\u0E32\u0E23\u0E4C\u200B\u0E21\u0E32\u200B\u0E01\u0E34\u0E19\u200B!"
  - "\u0E14\u0E39\u0E41\u0E25\u200B\u0E43\u0E2B\u0E49\u200B\u0E44\u0E14\u0E42\u0E19\u0E40\u0E2A\u0E32\u0E23\u0E4C\u0E2D\u0E34\u0E48\u0E21\u0E17\u0E49\u0E2D\u0E07\u200B\u0E2D\u0E22\u0E39\u0E48\u200B\u0E40\u0E2A\u0E21\u0E2D\u200B\u0E19\u0E30"
  - "\u0E14\u0E39\u200B\u0E41\u0E16\u0E1A\u200B\u0E04\u0E27\u0E32\u0E21\u200B\u0E2B\u0E34\u0E27\u200B\u0E40\u0E2B\u0E19\u0E37\u0E2D\u200B\u0E2B\u0E31\u0E27\u200B\u0E44\u0E14\u0E42\u0E19\u0E40\u0E2A\u0E32\u0E23\u0E4C
    \u0E16\u0E49\u0E32\u200B\u0E15\u0E31\u0E27\u200B\u0E44\u0E2B\u0E19\u200B\u0E2B\u0E21\u0E14\u200B\u0E2B\u0E25\u0E2D\u0E14\u200B\u0E04\u0E38\u0E13\u200B\u0E41\u0E1E\u0E49"
  autoHideSeconds: 15
  highlightRenderer: {fileID: 310739593}
  hoverGlow: {r: 0.22, g: 0.22, b: 0.22, a: 1}
